Name:           morsa
Version:        @VERSION@
Release:        @RELEASE@%{?dist}
Summary:        Linux metadata, OSINT and authorized reconnaissance CLI
License:        GPL-3.0-or-later
URL:            https://github.com/h0w4r/morsa
AutoReqProv:    no
Requires:       ca-certificates, glibc, libgcc, libstdc++, libicu, openssl-libs, zlib

%global debug_package %{nil}
# .NET single-file bundles carry an appended manifest. Generic brp-strip corrupts
# that footer, so prebuilt self-contained payloads must bypass RPM post-build strip.
%global __os_install_post %{nil}

%description
Morsa extracts metadata, correlates evidence, performs scoped discovery and
reconnaissance, and supports isolated parsers, plugins, MCP and proxy pools.

%prep
# The release pipeline supplies a prebuilt, self-contained payload.

%build
# No build occurs in rpmbuild; compilation is deterministic and precedes packaging.

%install
rm -rf %{buildroot}
mkdir -p %{buildroot}/usr
cp -a "@STAGE@/bin" "@STAGE@/libexec" "@STAGE@/share" %{buildroot}/usr/

%files
%license /usr/share/doc/morsa/LICENSE
%doc /usr/share/doc/morsa/NOTICE.md
%doc /usr/share/doc/morsa/README.md
%doc /usr/share/doc/morsa/README.es.md
%doc /usr/share/doc/morsa/docs
/usr/bin/morsa
/usr/libexec/morsa/morsa-parser-host
/usr/libexec/morsa/morsa-plugin-host
/usr/libexec/morsa/morsa-mcp
/usr/share/doc/morsa/BUILD-INFO
/usr/share/man/man1/morsa.1*
/usr/share/bash-completion/completions/morsa
/usr/share/zsh/site-functions/_morsa
/usr/share/fish/vendor_completions.d/morsa.fish

%changelog
* Sun Jul 26 2026 Morsa maintainers <security@users.noreply.github.com> - @VERSION@-@RELEASE@
- Automated, reproducible Morsa package.
